# Firebase Web App Configuration
# Replace these placeholders with your actual Firebase project settings in your local environment.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:1234567890abcdef

# OpenWeather API Configuration (Server-side proxy key)
# Used by /api/weather endpoint to fetch live weather metrics without exposing keys to client bundle.
OPENWEATHER_API_KEY=your_openweather_api_key_here
