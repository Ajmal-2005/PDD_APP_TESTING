{
  "name": "agrovision-appium-tests",
  "version": "1.0.0",
  "description": "Appium Mobile E2E Automation Testing Suite for AgroVision Web Application",
  "main": "tests/01_auth_onboarding.test.js",
  "type": "module",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:android": "wdio run wdio.conf.js --spec tests/**/*.test.js --capabilities.browserName=chrome",
    "test:ios": "wdio run wdio.conf.js --spec tests/**/*.test.js --capabilities.browserName=safari",
    "generate-report": "python generate_excel_report.py"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "e2e-testing",
    "mobile-automation",
    "agrovision"
  ],
  "author": "AgroVision QA Team",
  "license": "ISC",
  "dependencies": {
    "@wdio/appium-service": "^8.24.0",
    "@wdio/cli": "^8.24.0",
    "@wdio/local-runner": "^8.24.0",
    "@wdio/mocha-framework": "^8.24.0",
    "@wdio/spec-reporter": "^8.24.0",
    "appium": "^2.11.0",
    "chai": "^4.3.10",
    "webdriverio": "^8.24.0"
  }
}
